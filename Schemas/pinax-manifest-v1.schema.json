{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/gitkeniwo/pinax/main/Schemas/pinax-manifest-v1.schema.json",
  "title": "Pinax asset manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generated_at", "project", "backend", "assets"],
  "properties": {
    "schema": { "const": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "project": { "type": "string", "minLength": 1 },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "url_prefix"],
      "properties": {
        "slug": { "type": "string", "minLength": 1 },
        "url_prefix": { "type": "string", "format": "uri" }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha256", "key", "url", "bytes", "mime", "filename", "uploaded_at"],
        "properties": {
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "key": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "bytes": { "type": "integer", "minimum": 0 },
          "mime": { "type": "string", "minLength": 1 },
          "filename": { "type": "string", "minLength": 1 },
          "uploaded_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
